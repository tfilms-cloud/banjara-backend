# Copy to .env and replace every REPLACE_ME value. These placeholders are intentionally
# invalid so a copied file cannot accidentally run in production.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or:  openssl rand -hex 32
PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/banjara

# Must be >= 32 chars, distinct from each other, and never a REPLACE_ME placeholder.
JWT_ACCESS_SECRET=REPLACE_ME__access_secret_min_32_chars
JWT_REFRESH_SECRET=REPLACE_ME__different_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:8081
# Comma-separated extra origins for Socket.io + CORS
# Include your Expo LAN URL when testing on a physical device, e.g.:
# CLIENT_ORIGINS=http://localhost:19006,http://127.0.0.1:8081,http://localhost:3000,http://192.168.0.181:8081
CLIENT_ORIGINS=http://localhost:19006,http://127.0.0.1:8081,http://localhost:3000

# Website refresh-token cookie (httpOnly). lax works when the website and API share a
# site (localhost:3000 + localhost:5000, banjara.app + api.banjara.app). Set none only if
# they are on unrelated domains; none requires COOKIE_SECURE=true. COOKIE_SECURE defaults
# to true when NODE_ENV=production.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# Admin 2-step verification (authenticator app). ADMIN_REQUIRE_2FA defaults to true in
# production: admins must turn it on (admin portal → Security) before using the admin API.
# ADMIN_REQUIRE_2FA=true
# Encrypts the stored 2-step secrets. Set a random 32+ character value in production
# (it falls back to one derived from JWT_REFRESH_SECRET). Changing it later means admins
# must set up 2-step verification again.
MFA_ENCRYPTION_KEY=REPLACE_ME__generate_with_openssl_rand_hex_32

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-only Secret key (sb_secret_...) or legacy service_role JWT from this project.
# Publishable (sb_publishable_...) and anon keys cannot perform backend uploads.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=Banjara Images
SUPABASE_PAYMENT_BUCKET=banjara-payments-private

PAYMENT_SECRET=REPLACE_ME__not_mock_payment_secret
EXPO_NOTIFICATION_KEY=

GEOCODER_USER_AGENT=BanjaraApp/1.0 (support@banjara.app)
PLATFORM_FEE_RATE=0.05
TAX_RATE=0.1
SERVICE_FEE=200

# CNIC OCR — keys stay on the backend only (never in Expo).
# auto: use OCR.space when OCR_API_KEY is set, otherwise local tesseract.js
OCR_PROVIDER=auto
OCR_API_KEY=
OCR_API_URL=https://api.ocr.space/parse/image

# Background jobs: expire unpaid P2P payments + remind providers about pending bookings.
JOBS_ENABLED=true
JOBS_INTERVAL_MS=60000
PENDING_BOOKING_REMINDER_MINUTES=10

# Removed: CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET.
# Uploads use Supabase Storage (see src/config/supabase.ts); Cloudinary is not wired.

# City to City (intercity) rides: hard kill switch, off unless "true".
# Prices, windows and the runtime on/off live in the IntercitySettings collection
# (seed starter data with `npm run seed:intercity`; its fares are placeholders).
INTERCITY_ENABLED=false
