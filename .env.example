PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/banjara

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:8081
# Comma-separated extra origins for Socket.io + CORS
# Include your Expo LAN URL when testing on a physical device, e.g.:
# CLIENT_ORIGINS=http://localhost:19006,http://127.0.0.1:8081,http://localhost:3000,http://192.168.0.181:8081
CLIENT_ORIGINS=http://localhost:19006,http://127.0.0.1:8081,http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer the legacy service_role JWT (starts with eyJ...) from
# Project Settings → API. The new sb_secret_... key can fail with "Invalid JWT"
# depending on SDK/header handling.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=Banjara Images

PAYMENT_SECRET=mock_payment_secret
EXPO_NOTIFICATION_KEY=

GEOCODER_USER_AGENT=BanjaraApp/1.0 (support@banjara.app)
PLATFORM_FEE_RATE=0.05
TAX_RATE=0.1
SERVICE_FEE=200
